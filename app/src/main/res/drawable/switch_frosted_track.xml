<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中状态:毛玻璃蓝 -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/primary_alpha_30" />
            <stroke
                android:width="0.5dp"
                android:color="@color/primary_alpha_19" />
        </shape>
    </item>
    <!-- 未选中状态:毛玻璃灰 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/primary_alpha_19" />
            <stroke
                android:width="0.5dp"
                android:color="@color/gray_alpha_09" />
        </shape>
    </item>
</selector>
