<?xml version="1.0" encoding="utf-8"?>
<!-- 帖子详情页「正文头」item：作为评论区 RecyclerView 的第 0 项。
     整页只由一个 RecyclerView 滚动，恢复回收复用、消除嵌套滚动。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:descendantFocusability="blocksDescendants"
    android:paddingBottom="8dp">

    <!-- ========== 帖子头部 ========== -->
    <TextView
        android:id="@+id/tv_thread_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:lineSpacingExtra="6dp"
        android:letterSpacing="0.01" />
    <!-- 版块名:位于标题右下角 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_forum_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/thread_forum_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </LinearLayout>
    <!-- 标题与下方内容的隔离线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider" />
    <!-- 作者信息栏 -->
    <LinearLayout
        android:id="@+id/layout_author_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_author_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
            android:src="@drawable/ic_account"
            android:scaleType="centerCrop"
            android:contentDescription="作者头像" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_author_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_author_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_publish_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />
                <TextView
                    android:id="@+id/tv_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <!-- 关注按钮 -->
        <TextView
            android:id="@+id/btn_follow"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingHorizontal="12dp"
            android:text="@string/action_follow"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/thread_follow_bg"
            android:visibility="gone" />
    </LinearLayout>
    <!-- （此处的头像下方分隔线已按需求移除：标题下方那条线已足够分隔，
         重复加线会让头部显得很重） -->
    <!-- ========== 帖子正文（FrameLayout包裹：文本 + 链接覆盖层） ========== -->
    <!-- ========== 编辑标记区域(本帖最后由...编辑：靠左对齐头像，不加分割线) ========== -->
    <LinearLayout
        android:id="@+id/layout_edit_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/tv_edit_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:gravity="start"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:textStyle="italic" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="14dp">
        <TextView
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="6dp"
            android:letterSpacing="0.015" />
    </LinearLayout>
    <!-- 帖子正文中的图片容器(玻璃卡片 + 横向滑动 + 折叠) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_image_gallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        android:visibility="gone">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">
            <!-- 横向滑动图片区 -->
            <HorizontalScrollView
                android:id="@+id/hsv_image_gallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never">
                <LinearLayout
                    android:id="@+id/ll_image_gallery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>
            <!-- 折叠按钮(右上角) -->
            <ImageButton
                android:id="@+id/btn_collapse_images"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_circle_gray"
                android:src="@drawable/ic_back"
                android:rotation="90"
                android:scaleType="center"
                android:contentDescription="收起图片"
                android:padding="4dp" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>
    <!-- 正文内容的结束线：只划住图片，不含其后的打赏/好评/赞过行 -->
    <!-- ========== 隐藏内容区域（极简现代锁态卡片） ========== -->
    <LinearLayout
        android:id="@+id/layout_hidden_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_hidden_lock_card"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layout_hidden_locked_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 锁图标圆底 -->
            <FrameLayout
                android:id="@+id/layout_lock_circle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_lock_icon_circle">
                <ImageView
                    android:id="@+id/iv_hidden_lock"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lock_outline"
                    android:contentDescription="隐藏内容锁" />
            </FrameLayout>

            <!-- 文案区 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tv_hidden_content_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="包含隐藏内容"
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_hidden_content_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="回复本帖后自动刷新解锁"
                    android:textSize="11.5sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- 操作胶囊按钮 -->
            <TextView
                android:id="@+id/btn_view_hidden"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_unlock_action_btn"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="去回复"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_hidden_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14.5sp"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="5dp"
            android:visibility="gone" />
    </LinearLayout>
    <!-- 正文与评论区优雅过渡底线与呼吸间距 -->
    <View
        android:id="@+id/view_content_bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp"
        android:background="@color/divider" />
    <!-- ========== 评论标题栏 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_replies"
            android:textSize="15.5sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_reply_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_folded_badge"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_folded_badge"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 图二分段药丸选择器：浅灰底轨，包含「楼主」「正序」「倒序」 -->
        <LinearLayout
            android:id="@+id/layout_reply_segments"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_segment_track"
            android:padding="2dp">

            <!-- 楼主 -->
            <TextView
                android:id="@+id/btn_segment_op"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="楼主"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <!-- 正序 -->
            <TextView
                android:id="@+id/btn_segment_asc"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="正序"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />

            <!-- 倒序 -->
            <TextView
                android:id="@+id/btn_segment_desc"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="倒序"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- 空回复提示（无评论时显示） -->
    <TextView
        android:id="@+id/tv_empty_replies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/no_replies"
        android:textSize="14sp"
        android:textColor="@color/text_hint"
        android:visibility="gone" />
</LinearLayout>
