<?xml version="1.0" encoding="utf-8"?>
<!-- 帖子详情页「正文头」item：作为评论区 RecyclerView 的第 0 项。
     整页只由一个 RecyclerView 滚动，恢复回收复用、消除嵌套滚动。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:descendantFocusability="blocksDescendants"
    android:paddingBottom="8dp">

    <!-- ========== 帖子头部 ========== -->
    <TextView
        android:id="@+id/tv_thread_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:textSize="20sp"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:lineSpacingExtra="6dp"
        android:letterSpacing="0.01" />
    <!-- 版块名:位于标题右下角 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_forum_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/thread_forum_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </LinearLayout>
    <!-- 标题与下方内容的隔离线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider" />
    <!-- 作者信息栏 -->
    <LinearLayout
        android:id="@+id/layout_author_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_author_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
            android:src="@drawable/ic_account"
            android:scaleType="centerCrop"
            android:contentDescription="作者头像" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_author_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_author_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_publish_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />
                <TextView
                    android:id="@+id/tv_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <!-- 关注按钮（原 AI 总结按钮已移除） -->
        <TextView
            android:id="@+id/btn_follow"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingHorizontal="12dp"
            android:text="@string/action_follow"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/thread_follow_bg"
            android:visibility="gone" />
    </LinearLayout>
    <!-- （此处的头像下方分隔线已按需求移除：标题下方那条线已足够分隔，
         重复加线会让头部显得很重） -->
    <!-- ========== 帖子正文（FrameLayout包裹：文本 + 链接覆盖层） ========== -->
    <!-- ========== 编辑标记区域(本帖最后由...编辑：靠左对齐头像，不加分割线) ========== -->
    <LinearLayout
        android:id="@+id/layout_edit_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/tv_edit_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:gravity="start"
            android:textSize="11sp"
            android:textColor="@color/text_hint" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/frame_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp">
        <TextView
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="6dp" />
    </FrameLayout>
    <!-- 帖子正文中的图片容器(玻璃卡片 + 横向滑动 + 折叠) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_image_gallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        android:visibility="gone">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">
            <!-- 横向滑动图片区 -->
            <HorizontalScrollView
                android:id="@+id/hsv_image_gallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never">
                <LinearLayout
                    android:id="@+id/ll_image_gallery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>
            <!-- 折叠按钮(右上角) -->
            <ImageButton
                android:id="@+id/btn_collapse_images"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_circle_gray"
                android:src="@drawable/ic_back"
                android:rotation="90"
                android:scaleType="center"
                android:contentDescription="收起图片"
                android:padding="4dp" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>
    <!-- 正文内容的结束线：只划住图片，不含其后的打赏/好评/赞过行 -->
    <View
        android:id="@+id/view_content_bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:background="@color/divider" />
    <!-- ========== 隐藏内容区域 ========== -->
    <LinearLayout
        android:id="@+id/layout_hidden_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="@color/surface"
        android:padding="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tv_hidden_content_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hidden_content_prompt"
            android:textSize="13sp"
            android:textColor="@color/warning" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_hidden"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/view_hidden_content"
            android:textColor="?attr/colorPrimary" />
        <TextView
            android:id="@+id/tv_hidden_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />
    </LinearLayout>
    <!-- ========== 评论标题栏 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_replies"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_reply_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_only_op"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/reply_only_op"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reply_order"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="0dp"
            android:text="@string/reply_order_desc"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- 空回复提示（无评论时显示） -->
    <TextView
        android:id="@+id/tv_empty_replies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/no_replies"
        android:textSize="14sp"
        android:textColor="@color/text_hint"
        android:visibility="gone" />
</LinearLayout>
