<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    app:statusBarBackground="@color/background">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_primary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/main_pager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 左上角侧边栏入口 -->
        <ImageView
            android:id="@+id/btn_open_drawer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/ic_round_bg"
            android:elevation="6dp"
            android:padding="9dp"
            android:src="@drawable/ic_community_menu"
            app:tint="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="侧边栏" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 悬浮胶囊底部导航栏（4项 + 中间凸起发布按钮） -->
    <LinearLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="18dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/nav_bar_bg"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 第1项：首页 -->
        <LinearLayout
            android:id="@+id/nav_home_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            android:paddingHorizontal="4dp">

            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_home"
                android:contentDescription="首页"
                app:tint="@color/nav_icon_default" />

            <TextView
                android:id="@+id/nav_home_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="3dp"
                android:text="@string/tab_home"
                android:textColor="@color/nav_text_default"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 第2项：版块 -->
        <LinearLayout
            android:id="@+id/nav_community_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            android:paddingHorizontal="4dp">

            <ImageView
                android:id="@+id/nav_community_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_discover"
                android:contentDescription="发现"
                app:tint="@color/nav_icon_default" />

            <TextView
                android:id="@+id/nav_community_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="3dp"
                android:text="@string/tab_circle"
                android:textColor="@color/nav_text_default"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 第3项：居中发布按钮 -->
        <LinearLayout
            android:id="@+id/nav_post_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_post_icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:padding="9dp"
                android:src="@drawable/ic_add"
                android:background="@drawable/bg_nav_center_button"
                app:tint="@color/white"
                android:elevation="2dp"
                android:contentDescription="@string/action_post" />

        </LinearLayout>

        <!-- 第4项：消息 -->
        <LinearLayout
            android:id="@+id/nav_message_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            android:paddingHorizontal="4dp">

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:id="@+id/nav_message_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_message"
                    android:contentDescription="消息"
                    app:tint="@color/nav_icon_default" />

                <!-- 消息角标 -->
                <TextView
                    android:id="@+id/nav_message_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_gravity="top|right"
                    android:background="@drawable/badge_bg"
                    android:gravity="center"
                    android:minWidth="14dp"
                    android:paddingHorizontal="3dp"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/nav_message_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="3dp"
                android:text="@string/tab_message"
                android:textColor="@color/nav_text_default"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 第5项：我的 -->
        <LinearLayout
            android:id="@+id/nav_profile_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="8dp"
            android:paddingHorizontal="4dp">

            <ImageView
                android:id="@+id/nav_profile_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_profile"
                android:contentDescription="个人主页"
                app:tint="@color/nav_icon_default" />

            <TextView
                android:id="@+id/nav_profile_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="3dp"
                android:text="@string/tab_profile"
                android:textColor="@color/nav_text_default"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- 左侧功能侧边栏 -->
    <include
        layout="@layout/drawer_main"
        android:layout_width="256dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>