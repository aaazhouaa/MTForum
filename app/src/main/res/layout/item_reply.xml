<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <ImageView
            android:id="@+id/iv_reply_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_account"
            android:contentDescription="评论者头像" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_floor_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_reply_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="匿名" />

                <TextView
                    android:id="@+id/tv_op_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="楼主"
                    android:textSize="10sp"
                    android:textColor="?attr/colorPrimary"
                    android:background="@drawable/reply_op_badge_bg"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_reply_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_level_badge_gray"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="1.5dp"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <!-- 编辑标记：仅保留「修改时间 编辑」，紧跟用户名同行 -->
                <TextView
                    android:id="@+id/tv_reply_edit_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 引用块紧跟在用户名行下方（同一列内，横向位置与原先一致） -->
            <LinearLayout
                android:id="@+id/layout_reply_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:paddingEnd="10dp"
                android:paddingBottom="7dp"
                android:orientation="vertical"
                android:background="@drawable/reply_quote_bg"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_reply_quote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/reply_quote_content"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/tv_reply_quote_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:alpha="0.6" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_reply_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="3dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_reply_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="7dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 评论底栏操作行（图六排版）：时间属地在左，操作按钮在右 -->
    <LinearLayout
        android:id="@+id/layout_reply_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="45dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_reply_bottom_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <!-- 收起/展开回复：箭头 + 文字（折叠=向下箭头+「N 条回复」，展开=向上箭头+「收起回复」） -->
        <LinearLayout
            android:id="@+id/btn_toggle_sub_replies"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_toggle_arrow"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_right"
                android:scaleType="centerInside"
                android:importantForAccessibility="no"
                app:tint="@color/icon_secondary" />

            <TextView
                android:id="@+id/tv_toggle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:text="展开回复"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 回复按钮（气泡+横线图标，灰白） -->
        <ImageView
            android:id="@+id/btn_reply_text"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:padding="3dp"
            android:src="@drawable/ic_comment_lines"
            app:tint="@color/icon_secondary"
            android:scaleType="centerInside"
            android:contentDescription="回复"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- 楼中楼容器：放在底栏下方，缩进45dp对齐文字，内部承载动态子回复 -->
    <LinearLayout
        android:id="@+id/layout_sub_replies_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="45dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ll_sub_replies_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- 相同内容折叠提示胶囊条 -->
    <LinearLayout
        android:id="@+id/layout_collapsed_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="45dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/reply_nested_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_collapsed_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="?attr/colorPrimary"
            android:contentDescription="折叠" />

        <TextView
            android:id="@+id/tv_collapsed_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:text="已折叠 3 条相同回复 · 点击展开" />
    </LinearLayout>
</LinearLayout>