<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 白色 Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background_primary"
            android:theme="@style/ThemeOverlay.AppCompat.DayNight"
            app:title="@string/title_thread_detail"
            app:titleTextColor="@color/text_primary"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/text_primary">

            <ImageButton
                android:id="@+id/btn_share"
                android:layout_width="48dp"
                android:layout_height="?attr/actionBarSize"
                android:layout_gravity="end"
                android:minWidth="0dp"
                android:src="@drawable/forum_share"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_share"
                app:tint="@color/text_primary"
                android:padding="12dp" />
        </com.google.android.material.appbar.MaterialToolbar>

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/nested_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:descendantFocusability="blocksDescendants"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingBottom="8dp">

                    <!-- ========== 帖子头部 ========== -->
                    <TextView
                        android:id="@+id/tv_thread_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="12dp"
                        android:textSize="20sp"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        android:lineSpacingExtra="6dp"
                        android:letterSpacing="0.01" />

                    <!-- 版块名:位于标题右下角 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="4dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_forum_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/thread_forum_bg"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- 标题与下方内容的隔离线 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/divider" />

                    <!-- 作者信息栏 -->
                    <LinearLayout
                        android:id="@+id/layout_author_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_author_avatar"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
                            android:src="@drawable/ic_account"
                            android:scaleType="centerCrop"
                            android:contentDescription="作者头像" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tv_author_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_primary"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_author_level"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary"
                                    android:visibility="gone" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tv_publish_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/tv_location"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_hint"
                                    android:visibility="gone" />

                            </LinearLayout>
                        </LinearLayout>

                        <!-- build64: AI 一键总结(与列表卡片同款样式),放在关注按钮旁 -->
                        <TextView
                            android:id="@+id/btn_ai_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginEnd="6dp"
                            android:gravity="center"
                            android:minWidth="0dp"
                            android:paddingHorizontal="10dp"
                            android:text="AI总结"
                            android:textColor="@color/accent_ai"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/thread_ai_summary_bg" />

                        <TextView
                            android:id="@+id/btn_follow"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:gravity="center"
                            android:minWidth="44dp"
                            android:paddingHorizontal="12dp"
                            android:text="@string/action_follow"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/thread_follow_bg"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- 分隔线(编辑标记存在时隐藏,改用上下双线) -->
                    <View
                        android:id="@+id/view_content_top_divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/divider" />

                    <!-- ========== 帖子正文（FrameLayout包裹：文本 + 链接覆盖层） ========== -->
                    <!-- ========== 编辑标记区域(本帖最后由...编辑,紧贴作者栏,隔离线下留10dp) ========== -->
                    <LinearLayout
                        android:id="@+id/layout_edit_footer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:id="@+id/view_edit_divider_top"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="6dp"
                            android:background="@color/divider" />

                        <TextView
                            android:id="@+id/tv_edit_footer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="11sp"
                            android:textColor="@color/text_hint" />

                        <View
                            android:id="@+id/view_edit_divider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="10dp"
                            android:background="@color/divider" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/frame_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/tv_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="6dp" />

                    </FrameLayout>

                    <!-- 帖子正文中的图片容器(玻璃卡片 + 横向滑动 + 折叠) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_image_gallery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp">

                            <!-- 横向滑动图片区 -->
                            <HorizontalScrollView
                                android:id="@+id/hsv_image_gallery"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:scrollbars="none"
                                android:overScrollMode="never">

                                <LinearLayout
                                    android:id="@+id/ll_image_gallery"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical" />
                            </HorizontalScrollView>

                            <!-- 折叠按钮(右上角) -->
                            <ImageButton
                                android:id="@+id/btn_collapse_images"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_circle_gray"
                                android:src="@drawable/ic_back"
                                android:rotation="90"
                                android:scaleType="center"
                                android:contentDescription="收起图片"
                                android:padding="4dp" />
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ========== 隐藏内容区域 ========== -->
                    <LinearLayout
                        android:id="@+id/layout_hidden_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/surface"
                        android:padding="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_hidden_content_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hidden_content_prompt"
                            android:textSize="13sp"
                            android:textColor="@color/warning" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_view_hidden"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/view_hidden_content"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/tv_hidden_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="4dp"
                            android:visibility="gone" />

                    </LinearLayout>
                    <!-- ========== 帖子操作按钮（赞赏 + 踢帖） ========== -->
                    <LinearLayout
                        android:id="@+id/layout_thread_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/btn_reward"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_reward_btn"
                            android:text="@string/reward_title"
                            android:textColor="@android:color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:padding="0dp" />


                        <Button
                            android:id="@+id/btn_kick"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_kick_btn"
                            android:text="@string/kick_title"
                            android:textColor="@android:color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:padding="0dp" />

                    </LinearLayout>

                    <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/divider" />

        <!-- ========== 赞赏和好评详情模块 ========== -->
        <LinearLayout
            android:id="@+id/layout_reward_review_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <!-- 赞赏统计与头像 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_reward"
                        android:contentDescription="打赏"
                        app:tint="@color/warning"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tv_reward_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="人打赏"
                        android:textSize="12sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginStart="2dp" />

                    <TextView
                        android:id="@+id/tv_reward_coins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="共计 0 金币"
                        android:textSize="11sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/ll_reward_avatars"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 竖线分隔 -->
            <View
                android:layout_width="1dp"
                android:layout_height="52dp"
                android:background="@color/divider"
                android:layout_marginHorizontal="12dp" />

            <!-- 好评统计与头像 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_like"
                        android:contentDescription="点赞"
                        app:tint="@color/success"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tv_good_review_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="人好评"
                        android:textSize="12sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginStart="2dp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/ll_good_review_avatars"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />
                </HorizontalScrollView>
            </LinearLayout>

        </LinearLayout>

        <!-- ========== 点赞人头像行 ========== -->
        <LinearLayout
            android:id="@+id/layout_like_users"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            android:padding="6dp"
            android:background="@drawable/bg_like_users"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/liked_by"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_like_users"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tv_like_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/view_more"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>
        <!-- ========== 评论标题栏 ========== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/all_replies"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_reply_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:visibility="gone" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_only_op"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:text="@string/reply_only_op"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:textAllCaps="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_reply_order"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="6dp"
                            android:paddingEnd="0dp"
                            android:text="@string/reply_order_desc"
                            android:textSize="12sp"
                                        android:textColor="?attr/colorPrimary"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    <!-- ========== 回复列表 ========== -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_replies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />

                    <!-- 空回复提示 -->
                    <TextView
                        android:id="@+id/tv_empty_replies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="24dp"
                        android:text="@string/no_replies"
                        android:textSize="14sp"
                        android:textColor="@color/text_hint"
                        android:visibility="gone" />

                    <!-- 加载更多按钮 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_load_more"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:text="@string/load_more_replies"
                                    android:textColor="?attr/colorPrimary"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/loading_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone"
                        style="?android:attr/progressBarStyleSmall" />

                    <!-- ========== 帖子操作栏（底部快捷栏统一承载） ========== -->
                    <LinearLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content"
                         android:orientation="horizontal"
                         android:gravity="center"
                         android:paddingHorizontal="24dp"
                         android:paddingVertical="8dp"
                         android:visibility="gone">

                         <ImageButton
                             android:layout_width="48dp"
                             android:layout_height="48dp"
                             android:src="@drawable/ic_like"
                             android:contentDescription="点赞"
                             android:background="?attr/selectableItemBackgroundBorderless"
                             app:tint="@color/text_secondary"
                             android:padding="12dp" />

                         <ImageButton
                             android:layout_width="48dp"
                             android:layout_height="48dp"
                             android:src="@drawable/ic_star"
                             android:contentDescription="收藏"
                             android:background="?attr/selectableItemBackgroundBorderless"
                             app:tint="@color/text_secondary"
                             android:padding="12dp" />

                         <ImageButton
                             android:layout_width="48dp"
                             android:layout_height="48dp"
                             android:src="@drawable/ic_share"
                             android:contentDescription="分享"
                             android:background="?attr/selectableItemBackgroundBorderless"
                             app:tint="@color/text_secondary"
                             android:padding="12dp" />
                     </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- ========== 底部快捷操作栏：表情 / 图片 / @ / 评论 / 点赞 / 收藏 / 分享 ========== -->
        <HorizontalScrollView
            android:id="@+id/hsv_inline_image_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal"
            android:visibility="gone"
            android:background="@color/background_primary">

            <LinearLayout
                android:id="@+id/ll_inline_image_preview"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/layout_reply"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="6dp"
            android:background="@color/background_primary"
            android:elevation="10dp"
            android:visibility="gone">

<com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_reply"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                app:boxBackgroundMode="none"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_reply"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:background="@drawable/detail_reply_input_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:hint="说点什么吧..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="2"
                    android:imeOptions="actionSend" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 评论按钮容器 (图标 + 右侧灰白数字) -->
            <LinearLayout
                android:id="@+id/layout_comments"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/btn_comments"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:minWidth="0dp"
                    android:src="@drawable/forum_comment"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:contentDescription="查看评论"
                    app:tint="@color/icon_secondary" />

                <TextView
                    android:id="@+id/tv_comments_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 点赞按钮容器 (图标 + 右侧灰白数字) -->
            <LinearLayout
                android:id="@+id/layout_like"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/btn_like"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:minWidth="0dp"
                    android:src="@drawable/forum_like_off"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/action_like" />

                <TextView
                    android:id="@+id/tv_like_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 收藏按钮容器 (图标 + 右侧灰白数字) -->
            <LinearLayout
                android:id="@+id/layout_favorite"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/btn_favorite"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:minWidth="0dp"
                    android:src="@drawable/forum_favorite_off"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/action_favorite" />

                <TextView
                    android:id="@+id/tv_favorite_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 图片选择按钮 -->
            <LinearLayout
                android:id="@+id/layout_pick_image"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/btn_pick_image_inline"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:minWidth="0dp"
                    android:src="@drawable/ic_image"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:contentDescription="选择图片"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- 发送按钮(暂时注释)
            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="32dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:src="@drawable/ic_send"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="发送"
                app:tint="?attr/colorPrimary"
                android:padding="4dp" />
            -->
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>