<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 白色 Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background_primary"
            android:theme="@style/ThemeOverlay.AppCompat.DayNight"
            app:title="@string/title_thread_detail"
            app:titleTextColor="@color/text_primary"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/text_primary">

            <!-- 工具栏里 layout_gravity=end 的子项按 XML 顺序从右向左排列：
                 先写的靠最右。分享要固定在最右，所以它必须是第一个。 -->
            <ImageButton
                android:id="@+id/btn_share"
                android:layout_width="48dp"
                android:layout_height="?attr/actionBarSize"
                android:layout_gravity="end"
                android:minWidth="0dp"
                android:src="@drawable/forum_share"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_share"
                app:tint="@color/text_primary"
                android:padding="12dp" />

            <!-- 打赏图标 + 右上角人数角标 -->
            <FrameLayout
                android:id="@+id/layout_reward"
                android:layout_width="wrap_content"
                android:layout_height="?attr/actionBarSize"
                android:layout_gravity="end">

                <ImageButton
                    android:id="@+id/btn_reward"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:minWidth="0dp"
                    android:src="@drawable/ic_reward_coin"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/reward_title"
                    app:tint="@color/text_primary"
                    android:padding="12dp" />

                <!-- 打赏人数：灰色胶囊 + 深色字，低调不抢眼 -->
                <TextView
                    android:id="@+id/tv_reward_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="3dp"
                    android:minWidth="16dp"
                    android:paddingHorizontal="4dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:background="@drawable/bg_toolbar_badge"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btn_kick"
                android:layout_width="48dp"
                android:layout_height="?attr/actionBarSize"
                android:layout_gravity="end"
                android:minWidth="0dp"
                android:src="@drawable/ic_report_shield"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/kick_title"
                app:tint="@color/text_primary"
                android:padding="12dp" />
        </com.google.android.material.appbar.MaterialToolbar>

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_replies"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- ========== 底部快捷操作栏：表情 / 图片 / @ / 评论 / 点赞 / 收藏 / 分享 ========== -->
        <HorizontalScrollView
            android:id="@+id/hsv_inline_image_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal"
            android:visibility="gone"
            android:background="@color/background_primary">

            <LinearLayout
                android:id="@+id/ll_inline_image_preview"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/layout_reply"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="6dp"
            android:background="@color/background_primary"
            android:elevation="10dp"
            android:visibility="gone">

<com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_reply"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                app:boxBackgroundMode="none"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_reply"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:background="@drawable/detail_reply_input_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:hint="说点什么吧..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="2"
                    android:imeOptions="actionSend" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 评论按钮容器 (图标 + 右侧灰白数字) -->
            <LinearLayout
                android:id="@+id/layout_comments"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/btn_comments"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:minWidth="0dp"
                    android:src="@drawable/forum_comment"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:contentDescription="查看评论"
                    app:tint="@color/icon_secondary" />

                <TextView
                    android:id="@+id/tv_comments_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 点赞按钮容器 (图标 + 右侧灰白数字) -->
            <LinearLayout
                android:id="@+id/layout_like"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/btn_like"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:minWidth="0dp"
                    android:src="@drawable/forum_like_off"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/action_like" />

                <TextView
                    android:id="@+id/tv_like_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 收藏按钮容器 (图标 + 右侧灰白数字) -->
            <LinearLayout
                android:id="@+id/layout_favorite"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/btn_favorite"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:minWidth="0dp"
                    android:src="@drawable/forum_favorite_off"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/action_favorite" />

                <TextView
                    android:id="@+id/tv_favorite_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 图片选择按钮 -->
            <LinearLayout
                android:id="@+id/layout_pick_image"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/btn_pick_image_inline"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:minWidth="0dp"
                    android:src="@drawable/ic_image"
                    android:scaleType="fitCenter"
                    android:background="@android:color/transparent"
                    android:contentDescription="选择图片"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- 发送按钮(暂时注释)
            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="32dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:src="@drawable/ic_send"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="发送"
                app:tint="?attr/colorPrimary"
                android:padding="4dp" />
            -->
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>